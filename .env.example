# CodeMe — environment configuration
# Copy this to .env and fill in your values.
# The app reads this automatically via python-dotenv.

# ── Ollama (local AI) ────────────────────────────────────────────────────────
# URL of your Ollama server (default: http://localhost:11434)
CODEME_OLLAMA_URL=http://localhost:11434

# LLM used for code generation, planning, and chat.
# Must be pulled first: ollama pull codellama:7b
# Good choices: codellama:7b  |  qwen2.5-coder:7b  |  deepseek-coder:6.7b  |  llama3.2:3b
CODEME_LLM_MODEL=codellama:7b

# Embedding model used by the RAG engine (repo indexing + search).
# Must be pulled first: ollama pull nomic-embed-text
# Good choices: nomic-embed-text  |  mxbai-embed-large
CODEME_EMBED_MODEL=nomic-embed-text

# Request timeout in seconds (increase for slow/large models)
CODEME_OLLAMA_TIMEOUT=300

# Context window size passed to the model
CODEME_OLLAMA_CTX=32768

# ── API server ───────────────────────────────────────────────────────────────
# Allowed origins for the WebSocket API (comma-separated)
# Defaults to Electron + Vite dev server. Tighten in production.
CODEME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,app://.
